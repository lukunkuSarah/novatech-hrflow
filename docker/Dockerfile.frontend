# =============================================================================
# Image du frontend HRFlow
#
# Le frontend audité n'était pas constructible : ni `public/index.html`, ni
# point d'entrée `src/index.js` (QUA-09). L'étape « Build frontend » du pipeline
# ne pouvait donc pas réussir.
# =============================================================================

ARG NODE_VERSION=20.17-alpine

FROM node:${NODE_VERSION} AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY services/shared/package.json ./services/shared/
COPY services/api-gateway/package.json ./services/api-gateway/
COPY services/auth/package.json ./services/auth/
COPY services/paie/package.json ./services/paie/
COPY services/conges/package.json ./services/conges/
COPY services/recrutement/package.json ./services/recrutement/
COPY frontend/package.json ./frontend/

RUN npm ci --ignore-scripts

COPY frontend ./frontend

ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build --workspace=frontend

# -----------------------------------------------------------------------------
# Service des fichiers statiques
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Nginx écoute sur 8080 pour tourner sans privilèges.
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1
