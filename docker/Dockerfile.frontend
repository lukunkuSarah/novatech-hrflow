# =============================================================================
# Image du frontend HRFlow
#
# Le frontend audite n'etait pas constructible : ni public/index.html, ni point
# d'entree src/index.js (QUA-09). L'etape « build » du pipeline ne pouvait donc
# pas reussir.
#
# CETTE IMAGE CONSOMME UN ARTEFACT DEJA CONSTRUIT.
#
# L'etape 1 du pipeline execute deja `npm run build` et conserve `frontend/dist`
# en artefact. Reconstruire dans l'image reviendrait a construire deux fois le
# meme code, avec un risque reel de divergence entre ce qui est teste et ce qui
# est servi -- exactement le defaut CIC-06 releve dans l'audit, ou le serveur
# reconstruisait de son cote apres un `git pull`.
#
# Cela evite par ailleurs un obstacle technique : Vite 8 s'appuie sur Rolldown,
# dont le binaire natif n'est pas resolu par `npm ci` dans un conteneur Linux
# lorsque le fichier de verrouillage a ete genere sous Windows (bug npm/cli#4828).
#
# USAGE :
#   npm run build                              # produit frontend/dist
#   docker compose -f docker/docker-compose.yml build frontend
# =============================================================================

FROM nginx:1.27-alpine AS runtime

# Garde-fou : sans artefact, l'erreur doit etre lisible immediatement, pas se
# manifester par une page blanche apres deploiement.
COPY docker/verifier-artefact.sh /tmp/verifier-artefact.sh
COPY frontend/dist /usr/share/nginx/html
RUN sh /tmp/verifier-artefact.sh && rm /tmp/verifier-artefact.sh

COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Nginx ecoute sur 8080 pour tourner sans privileges.
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1
