{
  "name": "novatech-hrflow",
  "version": "3.0.0",
  "description": "HRFlow - Plateforme RH SaaS NovaTech",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "frontend",
    "services/shared",
    "services/api-gateway",
    "services/paie",
    "services/conges",
    "services/recrutement",
    "services/auth"
  ],
  "scripts": {
    "dev": "docker compose -f docker/docker-compose.yml up --build",
    "build": "npm run build --workspace=frontend",
    "lint": "eslint services --ext .js",
    "lint:fix": "eslint services --ext .js --fix",
    "format": "prettier --check \"services/**/*.js\"",
    "format:fix": "prettier --write \"services/**/*.js\"",
    "test": "npm run test --workspace=services/shared --workspace=services/api-gateway --workspace=services/auth --workspace=services/paie --workspace=services/conges --workspace=services/recrutement",
    "test:frontend": "npm run test --workspace=frontend",
    "audit:secrets": "gitleaks detect --no-git --redact --verbose",
    "migrate": "node db/migrate.js up",
    "migrate:down": "node db/migrate.js down",
    "smoke": "node scripts/smoke-test.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
