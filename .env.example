# ---------------------------------------------------------------------------
# NovaTech HRFlow — modèle de configuration
#
# Ce fichier est versionné. Il ne contient AUCUNE valeur réelle : uniquement
# les noms de variables attendues et leur format. Copiez-le en `.env` local et
# renseignez les valeurs — `.env` est ignoré par Git (SEC-01).
#
# En staging et en production, aucune de ces valeurs ne vient d'un fichier :
# elles sont injectées par le gestionnaire de secrets (GitHub Environments en
# CI, AWS Secrets Manager sur les serveurs). Voir docs/ADR-002-gestion-secrets.md
#
# Rappel : les services refusent de démarrer si une variable requise est
# absente, plutôt que d'utiliser une valeur par défaut (SEC-09).
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=dev

# --- Base de données -------------------------------------------------------
# Format : postgres://utilisateur:motdepasse@hote:port/base
DATABASE_URL=postgres://hrflow:changeme@localhost:5432/hrflow_dev

# --- Authentification ------------------------------------------------------
# Générer avec : openssl rand -hex 48
# Ne JAMAIS réutiliser la même valeur entre développement, staging et production.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m

# --- Réseau ----------------------------------------------------------------
# Liste d'origines autorisées, séparées par des virgules (SEC-11).
# Le caractère générique `*` n'est pas accepté.
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PAR_MINUTE=120
PROXY_TIMEOUT_MS=10000

# --- Adresses internes des services ----------------------------------------
AUTH_URL=http://localhost:3001
PAIE_URL=http://localhost:3002
CONGES_URL=http://localhost:3003
RECRUTEMENT_URL=http://localhost:3004

# --- Paiement --------------------------------------------------------------
# Clé de test (sk_test_...) en développement. La clé live n'existe que dans le
# gestionnaire de secrets de production.
STRIPE_SECRET_KEY=

# --- Courriel --------------------------------------------------------------
# Laisser vide en développement : un envoi console est utilisé à la place.
SENDGRID_API_KEY=
MAIL_FROM=no-reply@hrflow.novatech.io
RESET_URL_BASE=http://localhost:5173/reset

# --- Stockage des CV -------------------------------------------------------
# Répertoire hors arborescence servie par le serveur web (SEC-07).
UPLOAD_DIR=./tmp/cv
